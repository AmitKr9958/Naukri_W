TZ=Asia/Kolkata
RUN_EVERY_MINUTES=30
RUN_ON_START=true
DRY_RUN=true
LOG_LEVEL=info
RESUME_PATH=C:\Users\YourName\Documents\Resume.docx

NAUKRI_URL=https://www.naukri.com
NAUKRI_HEADLESS=false
# Keep false if you see Access Denied. System Google Chrome is preferred over Chromium.
NAUKRI_PROFILE_DIR=.naukri-profile
NAUKRI_AUTO_LOGIN=false
NAUKRI_USERNAME=
NAUKRI_PASSWORD=

JOB_MAX_AGE_HOURS=48
# Reject roles whose posted experience range tops out below this minimum.
JOB_MIN_EXPERIENCE_YEARS=5
JOB_LOCATIONS=Delhi,Gurgaon,Gurugram,Noida,Jaipur
JOB_ROLES=Power BI Developer,Power BI Lead,Power BI Engineer,Power BI Consultant,Data Analyst,Business Intelligence Analyst,Reporting Analyst,MIS Analyst
MIN_MATCH_SCORE=60
MAX_JOBS_PER_RUN=15
AI_CANDIDATE_LIMIT=30
# Scan up to five result pages for each query/location; runtime follows real Next links.
MAX_PAGES_PER_SEARCH=5
PAGE_DELAY_MS=400
# Use one browser tab to reduce CAPTCHA/security-check risk.
SEARCH_CONCURRENCY=1
# Delay between pages/search actions; the runtime enforces at least 1500ms.
PAGE_DELAY_MS=1500
# Search half the query categories each cycle; the two batches alternate.
JOB_SEARCH_BATCH_SIZE=3

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI fit analysis. Supports local 9Router or cloud OpenRouter.
AI_ENABLED=false
AI_CONSENT=false
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=kc/nvidia/nemotron-3.5-lightning:free
# OpenRouter alternative: AI_BASE_URL=https://openrouter.ai/api/v1 and AI_MODEL=openrouter/free

MAX_RETRIES=2
RETRY_DELAY_MS=1500
NAVIGATION_TIMEOUT_MS=25000
ACTION_TIMEOUT_MS=12000
HTTP_TIMEOUT_MS=20000
