TZ=Asia/Kolkata
RUN_EVERY_MINUTES=30
RUN_ON_START=true
DRY_RUN=true
LOG_LEVEL=info
RESUME_PATH=C:\Users\amitk\OneDrive\Desktop\Resume\Final Resume\Amit_Kumar_Team Lead.docx

NAUKRI_URL=https://www.naukri.com
NAUKRI_HEADLESS=false
# Keep false if you see Access Denied. System Google Chrome is preferred over Chromium.
NAUKRI_PROFILE_DIR=.naukri-profile
NAUKRI_AUTO_LOGIN=false
NAUKRI_USERNAME=
NAUKRI_PASSWORD=

JOB_MAX_AGE_HOURS=6
JOB_LOCATIONS=Delhi,Gurgaon,Gurugram,Noida,Jaipur
JOB_ROLES=Power BI Developer,Power BI Lead,Power BI Engineer,Power BI Consultant,Data Analyst,Business Intelligence Analyst,Reporting Analyst,MIS Analyst
MIN_MATCH_SCORE=60
MAX_JOBS_PER_RUN=15
AI_CANDIDATE_LIMIT=30
# Speed: 1 page is enough for a 6h freshness window. Raise only if needed.
MAX_PAGES_PER_SEARCH=1
PAGE_DELAY_MS=400
# Same browser, parallel tabs (1–5). 5 is faster; lower if Access Denied speed vs bot risk.
SEARCH_CONCURRENCY=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI fit analysis. Supports local 9Router or cloud OpenRouter.
AI_ENABLED=false
AI_CONSENT=false
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=kc/nvidia/nemotron-3.5-lightning:free
# OpenRouter alternative: AI_BASE_URL=https://openrouter.ai/api/v1 and AI_MODEL=openrouter/free

MAX_RETRIES=2
RETRY_DELAY_MS=1500
NAVIGATION_TIMEOUT_MS=25000
ACTION_TIMEOUT_MS=12000
HTTP_TIMEOUT_MS=20000
